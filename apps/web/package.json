{
	"name": "@framik/web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"start": "vite preview --host",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:push": "drizzle-kit push",
		"db:migrate": "drizzle-kit migrate",
		"db:generate-auth-migration": "bunx @better-auth/cli generate",
		"db:studio": "drizzle-kit studio",
		"postinstall": "bunx lefthook install"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.4",
		"@logtape/logtape": "^2.4.2",
		"@lucide/svelte": "^1.70.0",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.4",
		"@tanstack/svelte-table": "^9.3.1",
		"@types/node": "^26.6.6",
		"@vite-pwa/assets-generator": "^2.0.0",
		"@vite-pwa/sveltekit": "^2.0.0",
		"@vite-pwa/workbox-swkit": "^8.0.13",
		"bits-ui": "^2.20.6",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.11",
		"lefthook": "^2.2.2",
		"magicast": "^0.5.5",
		"mode-watcher": "^1.1.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.1",
		"tailwindcss": "^4.3.4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6",
		"vite": "^8.3.6"
	},
	"dependencies": {
		"@elysiajs/eden": "^1.4.9",
		"@framik/shared": "workspace:*",
		"@libsql/client": "^0.18.0",
		"@logtape/pretty": "^2.4.2",
		"@tanstack/svelte-form": "^1.33.5",
		"@tanstack/svelte-query": "^6.3.11",
		"@tanstack/svelte-query-devtools": "^6.3.11",
		"better-auth": "^1.7.18",
		"drizzle-orm": "^0.45.4",
		"elysia": "^1.4.31",
		"jimp": "1.6.0",
		"puppeteer": "^25.16.0",
		"zod": "^4.6.7"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
